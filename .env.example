# Copy this file to .env and fill in your own values for local development.
# In production (Render, etc.) set DATABASE_URL as an environment variable
# in the platform's dashboard instead of committing a real .env file.

# Postgres connection string. Works with Neon, Supabase, Render Postgres,
# or a local Postgres instance.
#
# Local example:
#   DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/product_browser
#
# Neon example (note ?sslmode=require is usually included in what Neon gives you):
#   DATABASE_URL=postgres://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Supabase example (use the "Connection pooling" string for serverless-friendly hosting):
#   DATABASE_URL=postgres://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Port the Express server listens on. Render sets this automatically; only
# needed for local dev (defaults to 3000 if unset).
PORT=3000
